    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.22",
    "libxml2-wasm": "^0.7.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
